{
  "version": 8,
  "name": "NullMaps VN Local",
  "glyphs": "/tiles/font/{fontstack}/{range}",
  "sprite": "/tiles/sprite/sprites",
  "sources": {
    "vn": {
      "type": "vector",
      "tiles": ["http://127.0.0.1:8088/tiles/vietnam/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 16
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#eef1ed" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "vn",
      "source-layer": "water",
      "paint": { "fill-color": "#8fc9e8" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "vn",
      "source-layer": "landcover",
      "paint": { "fill-color": "#cde7bc", "fill-opacity": 0.7 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "vn",
      "source-layer": "landuse",
      "paint": { "fill-color": "#e2ddd0", "fill-opacity": 0.65 }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "vn",
      "source-layer": "park",
      "paint": { "fill-color": "#bfe3b4", "fill-opacity": 0.75 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "vn",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#54a9d6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 16, 4]
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "vn",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#d1a13a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.2, 12, 3, 16, 10]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "vn",
      "source-layer": "transportation",
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary"],
          "#ffffff",
          ["secondary", "tertiary"],
          "#fff8e6",
          "#ffffff"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 12, 2, 16, 7]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "vn",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:vi"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 13]
      },
      "paint": {
        "text-color": "#555",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "vn",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name:vi"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 11, 12, 16, 16, 20],
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#17382d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    }
  ]
}
